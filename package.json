{
  "name": "@invoiceleaf/integration-sdk",
  "version": "2.1.0",
  "description": "SDK for building InvoiceLeaf integrations",
  "keywords": [
    "invoiceleaf",
    "integration",
    "sdk",
    "plugin"
  ],
  "license": "MIT",
  "author": "InvoiceLeaf <support@invoiceleaf.com>",
  "homepage": "https://invoiceleaf.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InvoiceLeaf/integration-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/InvoiceLeaf/integration-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
